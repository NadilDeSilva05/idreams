rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading shop profile info for Store Code verification
    match /users/{userId}/profile/info {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow shop owners and their registered shopkeepers to access the store's collections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/info).data.ownerUid == userId
      );
    }
  }
}
